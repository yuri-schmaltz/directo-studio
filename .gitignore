# Local data
maestro_data/
directo_data/

# Directo local-mode runtime artifacts (logs, pid files)
.directo-backend.log
.directo-frontend.log
.directo-backend.pid
.directo-frontend.pid

# Older log/console-capture files that were committed by accident
# in earlier commits (no leading dot in their original names). Still
# generated by `start.sh` / ad-hoc runs; safe to keep on disk.
.start.log
.backend.log
.frontend.log
.setsid.log

# Mavis team / orchestration session scratchpads. These are
# developer-local artifacts from a previous team session and should
# not be tracked in the repo. On-disk copies are preserved when
# removing them with `git rm --cached`.
.agents/

# NFS stale handles (network filesystem artifacts)
.nfs*

# Node / Next.js
ui/node_modules/
ui/.next/
ui/out/

# IDE
.vscode/
.idea/
*.swp
.DS_Store
